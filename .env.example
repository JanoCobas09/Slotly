# ============================================
# SaciaTurno — variables de entorno
# ============================================
# Copiá este archivo como `.env.local` y completá los valores.
# `.env.local` está en .gitignore: NO se commitea.
#
# Todo lo que empieza con VITE_ queda EXPUESTO en el bundle del browser.
# Eso está bien para las claves de Firebase (son públicas por diseño), y está
# MAL para cualquier token de API. Los secretos van en las Cloud Functions.

# ── Google OAuth (login) ───────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Firebase (Project settings → General → Tus apps → Configuración) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poné 'true' para trabajar contra los emuladores locales en vez de la base real
VITE_USE_EMULATORS=false

# Notificaciones push (FCM). Firebase Console → Project Settings → Cloud
# Messaging → "Certificados push web" → generar par de claves. Sin esto el
# botón de notificaciones del panel falla con un mensaje claro en vez de
# romper en silencio. Messaging NO tiene emulador: esto habla siempre con los
# servidores reales de FCM, VITE_USE_EMULATORS no lo afecta.
VITE_FIREBASE_VAPID_KEY=

# App Check (reCAPTCHA v3), protege el alta self-service (createBusinessSelfService)
# de bots. Site key de google.com/recaptcha/admin (tipo "reCAPTCHA v3"),
# registrado luego en Firebase Console → App Check → app web. Sin esto el alta
# self-service rechaza la llamada con un error claro; el resto de la app no
# se ve afectado.
VITE_RECAPTCHA_SITE_KEY=


# ===========================================================================
# LO DE ABAJO NO LLEVA PREFIJO VITE_ A PROPÓSITO.
# Son secretos: se cargan como secrets de Cloud Functions, nunca en el browser.
#   firebase functions:secrets:set WHATSAPP_TOKEN
# ===========================================================================

# WhatsApp Cloud API (Meta) — un número único de SACIA para todos los tenants
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Recordatorio de turno por mail (~3 hs antes, entre las 7:00 y las 20:00).
# Una casilla de Gmail dedicada para SACIA, NUNCA la personal de nadie —
# mismo criterio que el número único de WhatsApp de arriba. Necesita
# verificación en dos pasos activada y una contraseña de aplicación generada
# en myaccount.google.com/apppasswords (la contraseña normal de la cuenta no
# sirve para SMTP). Sin estas dos variables, la función no manda nada.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Mercado Pago (cobro de la seña, si se activa)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# n8n (recordatorios automáticos)
N8N_WEBHOOK_URL=
